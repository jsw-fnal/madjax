    @staticmethod
    def static_smatrix(p, model, user_helicities=None):
        #  
        %(info_lines)s
        # 
        # MadGraph5_aMC@NLO StandAlone Version
        # 
        # Returns amplitude squared summed/avg over colors
        # and helicities
        # for the point in phase space P(0:3,NEXTERNAL)
        #  
        %(process_lines)s
        #  
        # CONSTANTS
        #  
        nexternal = %(nexternal)d
        ndiags = %(ndiags)d
        ncomb = %(ncomb)d
        #  
        # LOCAL VARIABLES 
        #  
        %(den_factor_line)s
        %(hel_avg_factor_line)s
        %(helicity_lines)s

        if user_helicities is None:
            user_helicities = helicities

        # ----------
        # BEGIN CODE
        # ----------

        t = vmap(__class__.static_matrix, in_axes=(None,0,None), out_axes=0)(p, np.array(user_helicities), model)
        ans = np.sum(t)
        
        ans = ans * hel_avg_factor / denominator
        return ans.real

    @staticmethod
    def static_jamp(p, hel, model):

        #  
        %(info_lines)s
        #
        # Returns amplitude squared summed/avg over colors
        # for the point with external lines W(0:6,NEXTERNAL)
        #
        %(process_lines)s
        #  
        #  
        # Process parameters
        #  
        ngraphs = %(ngraphs)d
        nexternal = %(nexternal)d
        nwavefuncs = %(nwavefuncs)d
        ncolor = %(ncolor)d
        ZERO = 0.
        #
        # Model parameters
        #
        %(model_parameters)s
        # ----------
        # Begin code
        # ----------
        amp = [None] * ngraphs
        w = [None] * nwavefuncs
        %(helas_calls)s

        jamp = [None] * ncolor

        %(jamp_lines)s

        return jamp

    @staticmethod
    def static_matrix(p, hel, model):
        jamp = __class__.static_jamp(p, hel, model)

        matrix = np.sum( np.dot(np.array(__class__.cf), np.array(jamp).squeeze()) * np.array(jamp).squeeze().conjugate() / np.array(__class__.denom) )

        return matrix


    def smatrix(self, p, model, user_helicities=None):
        return self.static_smatrix(p, model, user_helicities)
    
    def matrix(self, p, hel, model):
        return self.static_matrix(p, hel, model)
